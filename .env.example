# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# -----------------------------------------------------------------------------
# AI Services (Google Gemini)
# Used for video content analysis (gemini-2.5-flash-lite) and itinerary generation
# -----------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# -----------------------------------------------------------------------------
# Google Maps Platform
# Requires Geocoding API, Places API (New), and Routes API enabled
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# -----------------------------------------------------------------------------
# Apify (Social Media Scraping)
# Uses clockworks/tiktok-scraper and apify/instagram-scraper
# If omitted, local mock data is used for testing
# -----------------------------------------------------------------------------
APIFY_API_TOKEN="your-apify-api-token"

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
